# Rendered from docs/database/templates/env.example by docs/database/render. Edit the template, not this file.
# Copy this file to .env next to compose.yaml and replace the values. Never commit .env.

# The password of the jellyfin database user and sa. SQL Server requires JELLYFIN_DB_PASSWORD to be at
# least 8 characters and include characters from at least three of uppercase letters, lowercase letters,
# digits, and symbols (without ; or quotes).
JELLYFIN_DB_PASSWORD=ChangeMe123!

# The folder with your media, mounted read-only at /media.
JELLYFIN_MEDIA_DIR=/path/to/media

# The port of Jellyfin on the host.
JELLYFIN_PORT=8096

# The tag of the image that "docker compose up --build" builds from this checkout.
JELLYFIN_IMAGE=jellyfin-multidb:local

# The edition of SQL Server: Developer (free for development and testing only) or Express (capped at
# 10 GB per database on 2022 or 50 GB on 2025).
MSSQL_PID=Developer
