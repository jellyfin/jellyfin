                + "and manual runs start once the workflow is on the default branch",
        }),
];

// Each template and where its output for an engine goes, relative to docs/database.
(string Template, Func<Engine, string> Output, string NoticeFormat)[] templates =
[
    ("templates/how-to.md", e => $"{e.Id}.md", "<!-- {0} -->"),
];

if (args.Length > 1 || (args.Length == 1 && args[0] != "--check"))
{
    return Fail($"Usage: {Command} [--check]");
}

var check = args.Length == 1;
var directory = FindDocsDirectory();
if (directory is null)
{
    return Fail($"Could not find docs/database above the working directory. Run {Command} from a checkout of the repository.");
}

var stale = new List<string>();
foreach (var (template, output, noticeFormat) in templates)
{
    var lines = File.ReadAllText(Path.Combine(directory, template)).ReplaceLineEndings("\n").Split('\n');
    foreach (var engine in engines)
    {
        string rendered;
        try
        {
            rendered = Render(lines, engine);
        }
        catch (InvalidOperationException ex)
        {
            return Fail($"{template} for {engine.Id}: {ex.Message}");
        }

        var notice = string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            noticeFormat,
            $"Rendered from docs/database/{template} by {Command}. Edit the template, not this file.");
        rendered = notice + "\n" + rendered;
        var path = Path.Combine(directory, output(engine));
        var relative = Path.GetRelativePath(directory, path).Replace('\\', '/');
        var current = File.Exists(path) ? File.ReadAllText(path).ReplaceLineEndings("\n") : null;
        if (current == rendered)
        {
            continue;
        }

        if (check)
        {
            stale.Add(relative);
            continue;
        }

        Directory.CreateDirectory(Path.GetDirectoryName(path)!);
        File.WriteAllText(path, rendered, new UTF8Encoding(false));
        Console.WriteLine($"Wrote docs/database/{relative}");
    }
}

if (stale.Count > 0)
{
    return Fail($"These files are not what their template gives: {string.Join(", ", stale.Select(e => "docs/database/" + e))}. Run {Command} and commit the result.");
}

if (check)
{
    Console.WriteLine("Every rendered file is up to date.");
}

return 0;

static string Render(string[] lines, Engine engine)
{
    var output = new StringBuilder();

    // One entry per open block: whether its lines are kept, and whether its {{else}} was seen.
    var blocks = new Stack<(bool Keep, bool Else, bool ParentKeeps)>();
    var keep = true;
    for (var number = 1; number <= lines.Length; number++)
    {
        var line = lines[number - 1];
        var trimmed = line.Trim();
        var condition = Regex.Match(trimmed, @"^\{\{#if ((?:[a-z-]+ ?)+)\}\}$");
        if (condition.Success)
        {
            var matches = condition.Groups[1].Value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Any(engine.Tags.Contains);
            blocks.Push((matches, false, keep));
            keep = keep && matches;
            continue;
        }

        if (trimmed == "{{else}}")
        {
            if (blocks.Count == 0 || blocks.Peek().Else)
            {
                throw new InvalidOperationException($"line {number} has an {{{{else}}}} without an open {{{{#if}}}}.");
            }

            var block = blocks.Pop();
            blocks.Push((!block.Keep, true, block.ParentKeeps));
            keep = block.ParentKeeps && !block.Keep;
            continue;
        }

        if (trimmed == "{{/if}}")
        {
            if (blocks.Count == 0)
            {
                throw new InvalidOperationException($"line {number} has an {{{{/if}}}} without an open {{{{#if}}}}.");
            }

            keep = blocks.Pop().ParentKeeps;
            continue;
        }

        if (!keep)
        {
            continue;
        }

        output.Append(Regex.Replace(line, @"\{\{([^}]*)\}\}", m => m.Groups[1].Value == "id"
            ? engine.Id
            : engine.Values.TryGetValue(m.Groups[1].Value, out var value)
                ? value
                : throw new InvalidOperationException($"line {number} uses {m.Value}, which {engine.Id} has no value for.")));
        if (number < lines.Length)
        {
            output.Append('\n');
        }
    }

    if (blocks.Count > 0)
    {
        throw new InvalidOperationException("a {{#if}} is not closed.");
    }

    return output.ToString();
}

static string? FindDocsDirectory()
{
    for (var directory = new DirectoryInfo(Environment.CurrentDirectory); directory is not null; directory = directory.Parent)
    {
        var candidate = Path.Combine(directory.FullName, "docs", "database");
        if (File.Exists(Path.Combine(directory.FullName, "Jellyfin.sln")) && Directory.Exists(candidate))
        {
            return candidate;
        }
    }

    return null;
}

static int Fail(string message)
{
    Console.Error.WriteLine(message);
    return 1;
}

internal sealed record Engine(string Id, string[] Tags, Dictionary<string, string> Values);
