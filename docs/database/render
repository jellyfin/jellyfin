#!/usr/bin/env dotnet
// Renders the operator page of each database engine from one template, so the pages cannot drift apart.
//
//   docs/database/render                    Linux and macOS
//   dotnet run docs/database/render         every platform
//   docs/database/render --check            fails if a rendered file is not what the template gives
//
// A template is plain text with three kinds of markup:
//   {{key}}                 the value of the key for the engine, or its id for {{id}}; an unknown key is an error
//   {{#if tag ...}}         on a line of its own: the lines up to the matching {{else}} or {{/if}} are kept only
//   {{else}} / {{/if}}      for an engine that has one of the tags; blocks can be nested
// Edit the template or the table below, never a rendered file, and run the command again.

using System.Text;
using System.Text.RegularExpressions;

const string Command = "docs/database/render";

// One row per engine. The tags select the blocks of the template, the values fill in the keys.
Engine[] engines =
[
