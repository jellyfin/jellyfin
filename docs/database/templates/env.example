# Copy this file to .env next to compose.yaml and replace the values. Never commit .env.

# The password of the jellyfin database user. Use a long random value without ; or quotes.
JELLYFIN_DB_PASSWORD=change-me

# The folder with your media, mounted read-only at /media.
JELLYFIN_MEDIA_DIR=/path/to/media

# The port of Jellyfin on the host.
JELLYFIN_PORT=8096

# The tag of the image that "docker compose up --build" builds from this checkout.
JELLYFIN_IMAGE=jellyfin-multidb:local
{{#if mysql-family}}

# The server-version option of database.xml, for example {{server-version-example}}. Leave it empty to have Jellyfin
# ask the server. It is read on the first start only, when database.xml is copied into the configuration volume.
JELLYFIN_DB_SERVER_VERSION=
{{/if}}
