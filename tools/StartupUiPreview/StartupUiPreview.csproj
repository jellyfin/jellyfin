<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Server.StartupUiPreview</RootNamespace>
    <!-- Developer-only preview harness for the startup UI; keep analyzer/doc friction low. -->
    <AnalysisMode>Default</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reused so the preview always renders through the exact same template + formatters as the live server. -->
    <ProjectReference Include="..\..\Jellyfin.Server\Jellyfin.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth: preview the real template shipped with the server. -->
    <None Include="..\..\Jellyfin.Server\ServerSetupApp\index.mstemplate.html" Link="index.mstemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
